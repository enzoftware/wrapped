---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import MusicPlayer from '../components/music/MusicPlayer';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Seis años de conversación. Su historia en números.' } = Astro.props;

// Link previews (WhatsApp, iMessage, X…) stay spoiler-free: just us and the
// anniversary, never the wrap's years or numbers.
const previewTitle = 'Enzo & Katy';
const previewDescription = 'Algo especial por nuestro 2 de octubre.';
const previewImage = new URL('/og-image.png', Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fdf6f0" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={previewTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={previewTitle} />
    <meta property="og:description" content={previewDescription} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:secure_url" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Una hoja de calendario en el 2 de octubre con «Enzo ♥ Katy»." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={previewTitle} />
    <meta name="twitter:description" content={previewDescription} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content="Una hoja de calendario en el 2 de octubre con «Enzo ♥ Katy»." />
    <ClientRouter />
  </head>
  <body>
    <div id="page" transition:animate="fade">
      <slot />
    </div>

    <!-- Lives outside #page and is never swapped, so the Spotify embed (and the song) survives navigation. -->
    <MusicPlayer client:load />

    <script>
      import { swapFunctions } from 'astro:transitions/client';

      // Swap only #page instead of the whole <body>. Moving an iframe in the DOM
      // reloads it (Safari has no moveBefore), which would stop the music.
      document.addEventListener('astro:before-swap', (e) => {
        e.swap = () => {
          swapFunctions.deselectScripts(e.newDocument);
          swapFunctions.swapHeadElements(e.newDocument);
          const restoreFocus = swapFunctions.saveFocus();
          const next = e.newDocument.getElementById('page');
          if (next) document.getElementById('page')?.replaceWith(next);
          restoreFocus();
        };
      });
    </script>
  </body>
</html>
