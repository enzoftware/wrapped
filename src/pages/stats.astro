---
import Base from '../layouts/Base.astro';
import GeneralStats from '../components/stats/GeneralStats';
import { globalStats, yearStats } from '../data/stats';
---

<Base title="Estadísticas · Enzo & Katy Wrap" description="Once años juntos, en números.">
  <header
    class="sticky top-0 z-40 flex items-center justify-between px-4 lg:px-8"
    style="padding-top: max(12px, env(safe-area-inset-top)); padding-bottom: 12px; background: rgba(253,246,240,0.82); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); box-shadow: 0 1px 0 var(--hair);"
  >
    <a
      href="/"
      class="inline-flex items-center gap-2 no-underline text-sm font-semibold px-3.5 py-2 rounded-full"
      style="color: var(--ink); background: rgba(45,26,31,0.06);"
    >
      <span aria-hidden="true">←</span> Volver al wrap
    </a>
    <span class="font-mono-custom text-[11px] tracking-[0.26em] uppercase" style="color: var(--accent);">
      ♥ Enzo &amp; Katy
    </span>
  </header>

  <GeneralStats client:load global={globalStats} years={yearStats} />

  <footer style="background: var(--bg); border-top: 1px solid rgba(45,26,31,0.08); text-align: center; padding: 48px 24px 120px;">
    <div class="font-mono-custom" style="font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint); margin-bottom: 10px;">
      Enzo &amp; Katy · {new Date().getFullYear()}
    </div>
    <p class="font-display italic" style="font-size: 22px; color: var(--sub); margin: 0;">
      132,105 mensajes. Un solo amor. ♥
    </p>
  </footer>

  <script>
    import { markIntroDone } from '../lib/music';
    // No intro gate on this page: let the player's "put on music" hint appear.
    markIntroDone();
  </script>
</Base>
